# Copiar a .env y completar las contraseñas requeridas con valores privados y distintos.
# Compose lee .env. Fuera de Compose, configurar las variables en el entorno de Node.

# Contraseña del superusuario de PostgreSQL para inicialización y administración.
POSTGRES_PASSWORD=

# Contraseña de origen_app. Compose la comparte entre el bootstrap y la aplicación.
DB_PASSWORD=

# Contraseña inicial de admin. Mínimo 12 caracteres y máximo 72 bytes UTF-8.
ADMIN_PASSWORD=

# Cuentas adicionales para la práctica local. Completar DEMO_PASSWORD sólo si se habilitan.
DEMO_MODE=false
DEMO_PASSWORD=

# Valores de conexión de Compose.
DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app

NODE_ENV=development
PORT=3000
APP_PORT=8080
# APP_ORIGIN=http://localhost:8080
UPLOADS_DIR=/app/uploads
# UPLOADS_STORAGE=./uploads
