# Copiar a .env y completar ambas contraseñas privadas y distintas.
# Compose lee .env. Fuera de Compose, configurar las variables en el entorno de Node.

# Contraseña del superusuario de PostgreSQL para inicialización y administración.
POSTGRES_PASSWORD=

# Contraseña de origen_app. Compose la comparte entre el bootstrap y la aplicación.
DB_PASSWORD=

# Valores de conexión de Compose.
DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app

NODE_ENV=development
PORT=3000
APP_PORT=8080
UPLOADS_DIR=/app/uploads
